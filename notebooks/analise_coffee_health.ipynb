  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "tem_problema_h9 = df[\"Health_Issues\"] != ROTULO_NAO_INFORMADO\n",
    "\n",
    "resultados_habitos = []\n",
    "for col, nome in [(\"Smoking\", \"Tabagismo\"), (\"Alcohol_Consumption\", \"Consumo de álcool\")]:\n",
    "    _, p_saude, _, _ = stats.chi2_contingency(pd.crosstab(df[col], tem_problema_h9))\n",
    "    _, p_sono = stats.ttest_ind(df.loc[df[col] == 1, \"Sleep_Hours\"], df.loc[df[col] == 0, \"Sleep_Hours\"])\n",
    "    resultados_habitos.append({\n",
    "        \"Hábito\": nome,\n",
    "        \"Problemas (Sim=1) %\": round(tem_problema_h9[df[col] == 1].mean() * 100, CASAS_DECIMAIS),\n",
    "        \"Problemas (Não=0) %\": round(tem_problema_h9[df[col] == 0].mean() * 100, CASAS_DECIMAIS),\n",
    "        \"p-valor Saúde\": formatar_p(p_saude),\n",
    "        \"Sono (Sim=1) h\": round(df.loc[df[col] == 1, \"Sleep_Hours\"].mean(), CASAS_DECIMAIS),\n",
    "        \"Sono (Não=0) h\": round(df.loc[df[col] == 0, \"Sleep_Hours\"].mean(), CASAS_DECIMAIS),\n",
    "        \"p-valor Sono\": formatar_p(p_sono),\n",
    "    })\n",
    "\n",
    "tabela_habitos_h9 = pd.DataFrame(resultados_habitos).set_index(\"Hábito\")\n",
    "f_ativ_h9, p_ativ_h9 = stats.f_oneway(*[sub[\"Physical_Activity_Hours\"].values for _, sub in df.groupby(\"Health_Issues\", observed=True)])\n",
    "r_ativ_bmi, _ = stats.pearsonr(df[\"Physical_Activity_Hours\"], df[\"BMI\"])\n",
    "r_ativ_fc, _ = stats.pearsonr(df[\"Physical_Activity_Hours\"], df[\"Heart_Rate\"])\n",
    "r_ativ_sono, _ = stats.pearsonr(df[\"Physical_Activity_Hours\"], df[\"Sleep_Hours\"])\n",
    "\n",
    "print(f\"ANOVA Atividade Física entre grupos de Health_Issues: F = {f_ativ_h9:.{CASAS_DECIMAIS}f}, p = {formatar_p(p_ativ_h9)}\")\n",
    "print(f\"Correlações de Atividade Física: BMI r = {r_ativ_bmi:.{CASAS_CORRELACAO}f} | FC r = {r_ativ_fc:.{CASAS_CORRELACAO}f} | Sono r = {r_ativ_sono:.{CASAS_CORRELACAO}f}\")\n",
