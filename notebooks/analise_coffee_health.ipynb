    "### H4 — Mais café eleva a frequência cardíaca\n",
    "\n",
    "- **Enunciado:** Maior consumo de café está associado a batimentos cardíacos mais altos (`Heart_Rate`) e maior proporção de frequência cardíaca elevada (`Heart_Rate >= LIMITE_FC_ALTA` bpm).\n",
    "- **Dados utilizados:** `Coffee_Intake` (contínua, em faixas `LIMITES_CAFE`, e corte `>= LIMITE_CAFE_ALTO`) e `Heart_Rate` (em bpm, além do indicador booleano `Heart_Rate >= 85` bpm).\n",
    "- **Análise:** Correlação de Pearson, regressão linear simples (`linregress`), média de `Heart_Rate` por faixa de consumo e comparação da proporção com FC ≥ 85 bpm (`>= 5` vs. `< 5`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "r_h4, p_h4 = stats.pearsonr(df[\"Coffee_Intake\"], df[\"Heart_Rate\"])\n",
    "reg_h4 = stats.linregress(df[\"Coffee_Intake\"], df[\"Heart_Rate\"])\n",
    "\n",
    "faixas_cafe_h4 = pd.cut(df[\"Coffee_Intake\"], bins=LIMITES_CAFE, include_lowest=True, labels=ROTULOS_CAFE)\n",
    "fc_alta = df[\"Heart_Rate\"] >= LIMITE_FC_ALTA\n",
    "resumo_fc_h4 = (\n",
    "    df.assign(FC_Alta=fc_alta * 100)\n",
    "    .groupby(faixas_cafe_h4, observed=True)\n",
    "    .agg(Registros=(\"Heart_Rate\", \"count\"), **{\"FC média (bpm)\": (\"Heart_Rate\", \"mean\"), f\"FC >= {LIMITE_FC_ALTA} (%)\": (\"FC_Alta\", \"mean\")})\n",
    "    .round(CASAS_DECIMAIS)\n",
    ")\n",
    "\n",
    "prop_5_mais = fc_alta[df[\"Coffee_Intake\"] >= LIMITE_CAFE_ALTO].mean() * 100\n",
    "prop_demais = fc_alta[df[\"Coffee_Intake\"] < LIMITE_CAFE_ALTO].mean() * 100\n",
    "\n",
    "print(f\"Pearson r = {r_h4:.{CASAS_CORRELACAO}f} (p {formatar_p(p_h4)}) | Inclinação = +{reg_h4.slope:.{CASAS_DECIMAIS}f} bpm por unidade de café\")\n",
    "print(f\"FC >= {LIMITE_FC_ALTA} bpm: {prop_5_mais:.{CASAS_DECIMAIS}f}% (>= {int(LIMITE_CAFE_ALTO)}) contra {prop_demais:.{CASAS_DECIMAIS}f}% (< {int(LIMITE_CAFE_ALTO)})\")\n",
    "display(resumo_fc_h4)\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(FIG_LARGURA, FIG_ALTURA))\n",
    "cores_h4 = sns.color_palette(n_colors=len(resumo_fc_h4))\n",
    "b1 = ax1.bar(resumo_fc_h4.index.astype(str), resumo_fc_h4[\"FC média (bpm)\"], color=cores_h4)\n",
    "ax1.bar_label(b1, fmt=f\"%.{CASAS_DECIMAIS}f\", padding=PADDING_ROTULO)\n",
    "ax1.set_title(\"H4: Frequência cardíaca média por faixa\")\n",
    "ax1.set_xlabel(\"Faixa de consumo (Coffee_Intake)\")\n",
    "ax1.set_ylabel(\"FC média (bpm)\")\n",
    "ax1.set_ylim(0, resumo_fc_h4[\"FC média (bpm)\"].max() * (1 + MARGEM_TOPO_GRAFICO))\n",
    "ax1.grid(axis=\"x\", visible=False)\n",
    "\n",
    "col_fc_alta = f\"FC >= {LIMITE_FC_ALTA} (%)\"\n",
    "b2 = ax2.bar(resumo_fc_h4.index.astype(str), resumo_fc_h4[col_fc_alta], color=cores_h4)\n",
    "ax2.bar_label(b2, fmt=f\"%.{CASAS_DECIMAIS}f%%\", padding=PADDING_ROTULO)\n",
    "ax2.set_title(f\"H4: Proporção com FC >= {LIMITE_FC_ALTA} bpm\")\n",
    "ax2.set_xlabel(\"Faixa de consumo (Coffee_Intake)\")\n",
    "ax2.set_ylabel(\"Registros (%)\")\n",
    "ax2.set_ylim(0, resumo_fc_h4[col_fc_alta].max() * (1 + MARGEM_TOPO_GRAFICO))\n",
    "ax2.grid(axis=\"x\", visible=False)\n",
    "\n",
    "sns.despine()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
