    "b1 = ax1.bar(sono_por_cafe_h1.index.astype(str), sono_por_cafe_h1[\"Sono médio (h)\"], color=cores_h1)\n",
    "ax1.bar_label(b1, fmt=f\"%.{CASAS_DECIMAIS}f\", padding=PADDING_ROTULO)\n",
    "ax1.set_title(\"H1: Horas médias de sono por faixa de consumo\")\n",
