    "\n",
    "b2 = ax2.bar(corr_etaria_h1.index.astype(str), corr_etaria_h1[\"Pearson r\"], color=sns.color_palette(\"muted\", n_colors=len(corr_etaria_h1)))\n",
    "ax2.bar_label(b2, fmt=f\"%.{CASAS_CORRELACAO}f\", padding=PADDING_ROTULO)\n",
    "ax2.axhline(0, color=\"gray\", linewidth=1)\n",
    "ax2.set_title(\"H1: Correlação café × sono por faixa etária\")\n",
