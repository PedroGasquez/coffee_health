    "            \"Sono h (média)\": (\"Sleep_Hours\", \"mean\"),\n",
    "            \"Sono h (mediana)\": (\"Sleep_Hours\", \"median\"),\n",
    "        },\n",
    "    )\n",
    "    .assign(**{\"% do total\": lambda t: t[\"Pessoas\"] / len(df) * 100})\n",
    "    .sort_values(\"Café (média)\", ascending=False)\n",
    "    .round(CASAS_DECIMAIS)\n",
    ")\n",
    "\n",
    "total_combinacoes = len(ORDEM_STRESS_LEVEL) * len(ORDEM_SLEEP_QUALITY)\n",
    "print(f\"Combinações existentes nos dados: {len(analise_conjunta)} de {total_combinacoes} possíveis\")\n",
    "analise_conjunta"
   ]
