   "source": [
    "matriz_corr = df[[\"Coffee_Intake\", \"Caffeine_mg\"]].corr().round(CASAS_CORRELACAO)\n",
    "correlacao_cafe_cafeina = df[\"Coffee_Intake\"].corr(df[\"Caffeine_mg\"])\n",
    "\n",
    "consumo_positivo = df[df[\"Coffee_Intake\"] > 0]\n",
    "mg_por_unidade = (consumo_positivo[\"Caffeine_mg\"] / consumo_positivo[\"Coffee_Intake\"]).mean()\n",
    "\n",
    "print(f\"Correlação de Pearson: {correlacao_cafe_cafeina:.{CASAS_CORRELACAO}f}\")\n",
    "print(f\"Razão média (entre registros com consumo > 0): {mg_por_unidade:.{CASAS_DECIMAIS}f} mg por unidade de Coffee_Intake\")\n",
    "matriz_corr"
   ]
