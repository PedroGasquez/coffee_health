    "ax.set_title(\"H9: Taxa de problemas de saúde por tabagismo e consumo de álcool\")\n",
    "ax.set_xlabel(\"Hábito\")\n",
    "ax.set_ylabel(\"Com problemas de saúde (%)\")\n",
    "ax.set_xticklabels(tabela_plot_h9.index, rotation=0)\n",
