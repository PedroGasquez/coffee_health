# Caminho do CSV, relativo à raiz do repositório
DATA_PATH=data/synthetic_coffee_health_10000.csv

# Semente para resultados reproduzíveis (train_test_split, DecisionTreeClassifier)
RANDOM_STATE=42

# Proporção dos dados reservada para teste (Q8)
TEST_SIZE=0.2

# Quantidade de países no ranking de consumo (Q4)
TOP_N_PAISES=5

# Tamanho padrão dos gráficos, em polegadas
FIG_LARGURA=10
FIG_ALTURA=5

# Limites das faixas etárias usadas na anonimização (LGPD); o último é exclusivo
FAIXAS_ETARIAS=18,30,45,81

# Tamanho mínimo de cada grupo de quase-identificadores (k-anonimato)
K_ANONIMATO=5
