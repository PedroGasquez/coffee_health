# Caminho do CSV, relativo à raiz do repositório
DATA_PATH=data/synthetic_coffee_health_10000.csv

# Semente para resultados reproduzíveis (train_test_split, DecisionTreeClassifier)
RANDOM_STATE=42

# Proporção dos dados reservada para teste (Q8)
TEST_SIZE=0.2

# Quantidade de países no ranking de consumo (Q4)
TOP_N_PAISES=5

# Tamanho padrão dos gráficos, em polegadas
FIG_LARGURA=10
FIG_ALTURA=5

# Casas decimais na exibição de tabelas, rótulos e correlação
CASAS_DECIMAIS=2
CASAS_CORRELACAO=4

# Folga vertical acima da maior barra, espaçamento de rótulos e estilo dos gráficos
MARGEM_TOPO_GRAFICO=0.18
PADDING_ROTULO=4
BINS_HISTOGRAMA=20
ALPHA_DISPERSAO=0.25
TAMANHO_PONTO=15

# Profundidade máxima da Árvore de Decisão podada (Q8)
MAX_PROFUNDIDADE_ARVORE=3
# Limites das faixas etárias usadas na anonimização (LGPD); o último é exclusivo
FAIXAS_ETARIAS=18,30,45,81

# Tamanho mínimo de cada grupo de quase-identificadores (k-anonimato)
K_ANONIMATO=5

# Parâmetros e limiares usados nos testes de hipóteses (Seção 8)
LIMITES_CAFE=0,1,3,5,100
LIMITE_CORTE_CAFE=3
LIMITE_CAFEINA_MG=400
LIMITES_CAFEINA=0,100,200,300,400,500,1000
LIMITE_FC_ALTA=85
CORTE_IDADE_RISCO=50
LIMITES_IMC=0,18.5,25,30,100
FAIXA_IMC_TABELA=25,32
MINUTOS_POR_HORA=60
LIMITE_P_EXIBICAO=0.001
